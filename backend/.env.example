APP_ENV=development
APP_NAME=EarnWorld Rewards
# Replace with a long random secret in the hosting provider's secret settings.
JWT_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
DATABASE_URL=sqlite:///./app.db
# Production example (use managed PostgreSQL; never commit real credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
ACCESS_TOKEN_MINUTES=30
